#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=lib/plugin.bash
. "$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )/../lib/plugin.bash"

# Get plugin configuration
PLUGIN_CONTEXT=$(plugin_read_config "CONTEXT" "git-diff")
PLUGIN_FORMAT=$(plugin_read_config "FORMAT" "markdown")
PLUGIN_COMPARE_BRANCH=$(plugin_read_config "COMPARE_BRANCH" "")  # Default to empty which is treated as current branch
PLUGIN_COMPARE_COMMITS=$(plugin_read_config "COMPARE_COMMITS" "1")
PLUGIN_INCLUDE_MERGE_BASE=$(plugin_read_config "INCLUDE_MERGE_BASE" "true")
PLUGIN_INCLUDE_SUBMODULES=$(plugin_read_config "INCLUDE_SUBMODULES" "false")
PLUGIN_COMPARE_PREVIOUS_BUILD=$(plugin_read_config "COMPARE_PREVIOUS_BUILD" "false")

# Lowercase via `tr` for Bash 3.2 compatibility (macOS). ${var,,} needs Bash 4+.
# `tr -d '\r\n'` strips any stray CR/LF (e.g. from a CRLF-sourced config value)
# before `read` trims leading/trailing whitespace, so neither falls through to
# the invalid-value branch below. Extra check is needed in case  plugin is ran with --no-plugin-validation
COMPARE_PREVIOUS_BUILD_LOWER=$(echo "${PLUGIN_COMPARE_PREVIOUS_BUILD}" | tr -d '\r\n' | tr '[:upper:]' '[:lower:]')
read -r COMPARE_PREVIOUS_BUILD_LOWER <<< "${COMPARE_PREVIOUS_BUILD_LOWER}"

# Normalize: true keeps the pre-existing state=passed behaviour;
# passed_or_failed matches builds in either state; false disables.
COMPARE_BUILD_ENABLED=false
COMPARE_BUILD_STATES=()
case "${COMPARE_PREVIOUS_BUILD_LOWER}" in
    true)
        COMPARE_BUILD_ENABLED=true
        COMPARE_BUILD_STATES=("passed") ;;
    false)
        : ;;
    passed_or_failed)
        COMPARE_BUILD_ENABLED=true
        COMPARE_BUILD_STATES=("passed" "failed") ;;
    *)
        # Bounded to keep a misconfigured (e.g. accidentally huge) value from
        # bloating the annotation body.
        buildkite-agent annotate "Invalid \`compare_previous_build\` value: \`${PLUGIN_COMPARE_PREVIOUS_BUILD:0:200}\`. Must be \`true\`, \`false\`, or \`passed_or_failed\`." \
            --context "${PLUGIN_CONTEXT}" \
            --style "error" \
            --append
        exit 1 ;;
esac

# buildkite-agent caps annotation bodies at 1 MiB (1048576 bytes). Default to a
# slightly lower value so we leave headroom for the agent's own overhead.
PLUGIN_MAX_BODY_BYTES_DEFAULT=1000000
PLUGIN_MAX_BODY_BYTES=$(plugin_read_config "MAX_BODY_BYTES" "${PLUGIN_MAX_BODY_BYTES_DEFAULT}")

# Validate in case  plugin is ran with --no-plugin-validation 
# PLUGIN_MAX_BODY_BYTES must be a positive integer and must not exceed the default cap
if ! [[ "${PLUGIN_MAX_BODY_BYTES}" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: max_body_bytes must be a positive integer (got '${PLUGIN_MAX_BODY_BYTES}')" >&2
    exit 1
fi
if (( PLUGIN_MAX_BODY_BYTES > PLUGIN_MAX_BODY_BYTES_DEFAULT )); then
    echo "Error: max_body_bytes (${PLUGIN_MAX_BODY_BYTES}) must not exceed ${PLUGIN_MAX_BODY_BYTES_DEFAULT}" >&2
    exit 1
fi

# Reserve a slice of the cap for the truncation notice (preamble + omitted
# files list) so the complete body — diff sections + notice — stays under the
# cap. Minimum 2 KiB, maximum half of the cap.
NOTICE_RESERVE=$(( PLUGIN_MAX_BODY_BYTES / 20 ))
(( NOTICE_RESERVE < 2048 )) && NOTICE_RESERVE=2048
(( NOTICE_RESERVE > PLUGIN_MAX_BODY_BYTES / 2 )) && NOTICE_RESERVE=$(( PLUGIN_MAX_BODY_BYTES / 2 ))
CONTENT_BUDGET=$(( PLUGIN_MAX_BODY_BYTES - NOTICE_RESERVE ))

# Get current SHA
CURRENT_SHA=${BUILDKITE_COMMIT}

# Tempfile paths — pre-declared so one EXIT trap covers the API-call tempfile,
# the markdown-rendering tempfile, and the per-file section buffer without
# re-trapping later (trap EXIT replaces the handler rather than stacking it,
# so reassigning it after one of these is created would drop the others).
HEADERS_FILE=""
TEMP_MD=""
SECTION_TMP=""
# `|| true` matters more than it looks: under `set -e`, a failing command inside an EXIT
# trap overrides whatever exit status the script was already returning (even an explicit
# `exit 0`), so a transient rm failure during cleanup must never flip a successful run into
# a reported failure. `2>/dev/null` just silences rm's stderr if that ever happens.
trap 'rm -f "${HEADERS_FILE}" "${TEMP_MD}" "${SECTION_TMP}" 2>/dev/null || true' EXIT

# Set up git diff flags
DIFF_FLAGS=""
if [[ "${PLUGIN_INCLUDE_SUBMODULES:-false}" =~ ^(true|on|1)$ ]]; then
    DIFF_FLAGS="--submodule=diff"
fi

if [[ "${COMPARE_BUILD_ENABLED}" == "true" ]]; then
    # BUILDKITE_BRANCH is always set in real Buildkite jobs; guard for local/synthetic runs
    # so the hook fails loudly rather than sending `branch=` (which Buildkite may treat as
    # no filter, silently diffing against an unrelated branch's commit).
    if [ -z "${BUILDKITE_BRANCH:-}" ]; then
        buildkite-agent annotate "compare_previous_build requires BUILDKITE_BRANCH to be set" \
            --context "${PLUGIN_CONTEXT}" \
            --style "error" \
            --append
        exit 1
    fi

    # BUILDKITE_BUILD_NUMBER is always set (as an integer) in real Buildkite jobs; guard for
    # local/synthetic runs so the hook fails loudly instead of letting a non-numeric value
    # crash `jq --argjson` below with a raw, unannotated error.
    if ! [[ "${BUILDKITE_BUILD_NUMBER:-}" =~ ^[0-9]+$ ]]; then
        buildkite-agent annotate "compare_previous_build requires BUILDKITE_BUILD_NUMBER to be set to an integer" \
            --context "${PLUGIN_CONTEXT}" \
            --style "error" \
            --append
        exit 1
    fi

    # Validate if the API access token is present
    if [ -z "${BUILDKITE_API_TOKEN:-}" ]; then
        echo "Error: BUILDKITE_API_TOKEN is required when compare_previous_build is enabled"
        exit 1
    fi

    # Build curl args as an array so --data-urlencode handles branch names
    # containing +, &, #, / and other characters that would otherwise be mis-parsed.
    # per_page=5 tolerates a handful of concurrent builds that may have finished before us.
    CURL_ARGS=(
        -s
        --get
        -H "Authorization: Bearer ${BUILDKITE_API_TOKEN}"
        --data-urlencode "branch=${BUILDKITE_BRANCH}"
        --data-urlencode "per_page=5"
        --data-urlencode "exclude_jobs=true"
    )
    # Rails-style multi-value filter: state[]=passed[&state[]=failed]
    for STATE in "${COMPARE_BUILD_STATES[@]}"; do
        CURL_ARGS+=(--data-urlencode "state[]=${STATE}")
    done

    # Fetch with up to one retry on 429. Captures body and HTTP status in one call;
    # dumps response headers so we can honour Retry-After / RateLimit-Reset.
    HEADERS_FILE=$(mktemp)
    HTTP_STATUS=""
    API_RESPONSE=""
    for ATTEMPT in 1 2; do
        curl_out=$(curl "${CURL_ARGS[@]}" \
            -D "${HEADERS_FILE}" \
            -w '\n%{http_code}' \
            "https://api.buildkite.com/v2/organizations/${BUILDKITE_ORGANIZATION_SLUG}/pipelines/${BUILDKITE_PIPELINE_SLUG}/builds") || curl_out=""
        HTTP_STATUS="${curl_out##*$'\n'}"
        API_RESPONSE="${curl_out%$'\n'*}"
        [ "${HTTP_STATUS}" != "429" ] && break
        [ "${ATTEMPT}" = "2" ] && break
        retry_after=$(grep -iE '^(retry-after|ratelimit-reset):' "${HEADERS_FILE}" | head -1 | awk '{print $2}' | tr -d '\r\n')
        [[ "${retry_after}" =~ ^[0-9]+$ ]] || retry_after=2
        echo "Rate limited by Buildkite API; retrying in ${retry_after}s..."
        sleep "${retry_after}"
    done

    if [ "${HTTP_STATUS}" != "200" ]; then
        buildkite-agent annotate "Failed to fetch build information from Buildkite API (HTTP ${HTTP_STATUS:-unknown})" \
            --context "${PLUGIN_CONTEXT}" \
            --style "error" \
            --append
        exit 1
    fi

    # Validate that response must be an "array" type
    if ! jq -e 'type == "array"' >/dev/null 2>&1 <<< "${API_RESPONSE}"; then
        buildkite-agent annotate "Unexpected Buildkite API response shape (expected array of builds)" \
            --context "${PLUGIN_CONTEXT}" \
            --style "error" \
            --append
        exit 1
    fi

    # Pick the first returned build whose number is strictly less than ours. The /builds
    # endpoint is sorted newest-first, so a later-triggered build that finished first (e.g.
    # a quick failure on the next commit) would otherwise be picked as "previous". `//
    # empty` yields "" when no earlier build is found, which the next guard converts into a
    # friendly annotation.
    PREVIOUS_BUILD_SHA=$(jq -r --argjson current "${BUILDKITE_BUILD_NUMBER}" \
        'map(select(.number < $current and .commit != null)) | .[0].commit // empty' \
        <<< "${API_RESPONSE}")

    if [ -z "${PREVIOUS_BUILD_SHA}" ]; then
        buildkite-agent annotate "No previous build found on branch ${BUILDKITE_BRANCH}" \
            --context "${PLUGIN_CONTEXT}" \
            --style "warning" \
            --append
        exit 0
    fi

    # Validate that the commit can be fetched
    if ! git cat-file -e "${PREVIOUS_BUILD_SHA}^{commit}" 2>/dev/null; then
        echo "Fetching commit ${PREVIOUS_BUILD_SHA} from remote..."
        if ! git fetch origin "${PREVIOUS_BUILD_SHA}"; then
            buildkite-agent annotate "Error: Could not fetch commit ${PREVIOUS_BUILD_SHA}" \
                --context "${PLUGIN_CONTEXT}" \
                --style "error" \
                --append
            exit 1
        fi
    fi

    COMPARE_SHA=${PREVIOUS_BUILD_SHA}
elif [ -n "${PLUGIN_COMPARE_BRANCH}" ]; then
    # If compare_branch is set, fetch and compare against it
    git fetch origin "${PLUGIN_COMPARE_BRANCH}"
    TARGET_BRANCH_SHA=$(git rev-parse "origin/${PLUGIN_COMPARE_BRANCH}")

    if [[ "${PLUGIN_INCLUDE_MERGE_BASE:-true}" =~ ^(true|on|1)$ ]]; then
        # Find the merge-base (common ancestor) between target branch and current commit
        COMPARE_SHA=$(git merge-base "${TARGET_BRANCH_SHA}" "${CURRENT_SHA}")
    else
        # Use the head of the target branch
        COMPARE_SHA=${TARGET_BRANCH_SHA}
    fi
else
    # If no compare_branch is set, compare against N commits back
    COMPARE_SHA=$(git rev-parse "${CURRENT_SHA}~${PLUGIN_COMPARE_COMMITS}")
fi

# Check if there are any changes
if [[ -z "$(git diff --numstat ${DIFF_FLAGS} "${COMPARE_SHA}" "${CURRENT_SHA}")" ]]; then
    if [[ "${COMPARE_BUILD_ENABLED}" == "true" ]]; then
        buildkite-agent annotate "No changes found between previous build (${COMPARE_SHA:0:8}) and current build (${CURRENT_SHA:0:8})" \
            --context "${PLUGIN_CONTEXT}" \
            --style "info" \
            --append
    elif [ -n "${PLUGIN_COMPARE_BRANCH}" ]; then
        buildkite-agent annotate "No changes found between ${COMPARE_SHA:0:8} on ${PLUGIN_COMPARE_BRANCH} and ${CURRENT_SHA:0:8} on ${BUILDKITE_BRANCH}" \
            --context "${PLUGIN_CONTEXT}" \
            --style "info" \
            --append
    else
        if [[ "${PLUGIN_COMPARE_COMMITS}" -eq 1 ]]; then
            buildkite-agent annotate "No changes found between commits ${COMPARE_SHA:0:8} and ${CURRENT_SHA:0:8}" \
                --context "${PLUGIN_CONTEXT}" \
                --style "info" \
                --append
        else
            buildkite-agent annotate "No changes found in the last ${PLUGIN_COMPARE_COMMITS} commits (${COMPARE_SHA:0:8} to ${CURRENT_SHA:0:8})" \
                --context "${PLUGIN_CONTEXT}" \
                --style "info" \
                --append
        fi
    fi
    exit 0
fi

# Create temporary markdown file
TEMP_MD=$(mktemp)

if [[ "${PLUGIN_FORMAT}" == "markdown" ]]; then
    # Add header
    if [[ "${COMPARE_BUILD_ENABLED}" == "true" ]]; then
        HEADER="Comparing changes between previous build (${COMPARE_SHA:0:8}) and current build (${CURRENT_SHA:0:8})\n"
    elif [ -n "${PLUGIN_COMPARE_BRANCH}" ]; then
        HEADER="Comparing changes between ${COMPARE_SHA:0:8} on ${PLUGIN_COMPARE_BRANCH} to ${CURRENT_SHA:0:8} on ${BUILDKITE_BRANCH}\n"
    else
        if [[ "${PLUGIN_COMPARE_COMMITS}" -eq 1 ]]; then
            HEADER="Comparing changes between commits ${COMPARE_SHA:0:8} and ${CURRENT_SHA:0:8}\n"
        else
            HEADER="Comparing changes in the last ${PLUGIN_COMPARE_COMMITS} commits (${COMPARE_SHA:0:8} to ${CURRENT_SHA:0:8})\n"
        fi
    fi

    # shellcheck disable=SC2129
    echo -e "${HEADER}" >> "${TEMP_MD}"

    # Get list of changed files
    FILES_CHANGED=$(git diff --name-only ${DIFF_FLAGS} "${COMPARE_SHA}" "${CURRENT_SHA}")

    # Add summary line
    SUMMARY=$(git diff --numstat ${DIFF_FLAGS} "${COMPARE_SHA}" "${CURRENT_SHA}" | awk '
        BEGIN { additions = 0; deletions = 0; files = 0 }
        {
            additions += $1;
            deletions += $2;
            files += 1
        }
        END {
            print files " files changed, " additions " insertions(+), " deletions " deletions(-)"
        }
    ')

    echo -e "**Summary:** ${SUMMARY}\n" >> "${TEMP_MD}"

    # Build expandable sections for each file, stopping once the next section
    # would push the body past CONTENT_BUDGET (which leaves room for the notice).
    TRUNCATED=false
    OMITTED_FILES=()
    SECTION_TMP=$(mktemp)

    for FILE in ${FILES_CHANGED}; do
        if [[ "${TRUNCATED}" == true ]]; then
            OMITTED_FILES+=("${FILE}")
            continue
        fi

        FILE_EXT="${FILE##*.}"
        if [ "$FILE_EXT" = "$FILE" ] || [[ "$FILE_EXT" == */* ]]; then
            FILE_EXT="txt"
        fi

        # Build this file's section in a buffer so we can measure it before
        # committing it to the annotation body.
        {
            echo "<details>"
            echo "<summary><strong>${FILE}</strong></summary>"
            echo
            echo '```'"${FILE_EXT}"
            git diff ${DIFF_FLAGS} "${COMPARE_SHA}" "${CURRENT_SHA}" -- "${FILE}"
            echo '```'
            echo "</details>"
            echo
        } > "${SECTION_TMP}"

        CURRENT_SIZE=$(wc -c < "${TEMP_MD}")
        SECTION_SIZE=$(wc -c < "${SECTION_TMP}")
        if (( CURRENT_SIZE + SECTION_SIZE > CONTENT_BUDGET )); then
            TRUNCATED=true
            OMITTED_FILES+=("${FILE}")
            continue
        fi

        cat "${SECTION_TMP}" >> "${TEMP_MD}"
    done

    if [[ "${TRUNCATED}" == true ]]; then
        # Preamble is always emitted; the omitted list gets truncated with
        # "... and N more file(s)" if it would push the body over the cap.
        {
            echo
            echo "> :warning: **Diff truncated.** The full diff exceeds the configured annotation size limit."
            echo "> ${#OMITTED_FILES[@]} file(s) were omitted from this annotation:"
            echo ">"
        } >> "${TEMP_MD}"

        LISTED=0
        TAIL_RESERVE=80   # bytes kept free for the "... and N more" tail
        for F in "${OMITTED_FILES[@]}"; do
            LINE="> - \`${F}\`"
            LINE_BYTES=$(( ${#LINE} + 1 ))   # +1 for newline
            CURRENT_SIZE=$(wc -c < "${TEMP_MD}")
            if (( CURRENT_SIZE + LINE_BYTES + TAIL_RESERVE > PLUGIN_MAX_BODY_BYTES )); then
                REMAINING=$(( ${#OMITTED_FILES[@]} - LISTED ))
                echo "> - ... and ${REMAINING} more file(s)" >> "${TEMP_MD}"
                break
            fi
            echo "${LINE}" >> "${TEMP_MD}"
            LISTED=$(( LISTED + 1 ))
        done
    fi
else
    # Raw diff format
    git diff --color=always ${DIFF_FLAGS} "${COMPARE_SHA}" "${CURRENT_SHA}" > "${TEMP_MD}"

    RAW_SIZE=$(wc -c < "${TEMP_MD}")
    if (( RAW_SIZE > PLUGIN_MAX_BODY_BYTES )); then
        TRUNCATED_TMP=$(mktemp)
        # Truncate to CONTENT_BUDGET at a line boundary, then append the notice.
        head -c "${CONTENT_BUDGET}" "${TEMP_MD}" | sed '$d' > "${TRUNCATED_TMP}"
        {
            cat "${TRUNCATED_TMP}"
            echo
            echo "--- Diff truncated: full output (${RAW_SIZE} bytes) exceeds Buildkite's annotation body limit (1 MiB). ---"
        } > "${TEMP_MD}"
        rm -f "${TRUNCATED_TMP}"
    fi
fi

# Safety net: if the body is still over the cap for any reason, hard-truncate
# so buildkite-agent accepts it (it rejects >1 MiB client-side).
FINAL_SIZE=$(wc -c < "${TEMP_MD}")
if (( FINAL_SIZE > PLUGIN_MAX_BODY_BYTES )); then
    SAFETY_TMP=$(mktemp)
    head -c "${PLUGIN_MAX_BODY_BYTES}" "${TEMP_MD}" > "${SAFETY_TMP}"
    mv "${SAFETY_TMP}" "${TEMP_MD}"
fi

# Pipe the body in via stdin to avoid ARG_MAX ("Argument list too long") on
# large diffs.
buildkite-agent annotate \
    --context "${PLUGIN_CONTEXT}" \
    --style "info" \
    --append \
    < "${TEMP_MD}"
